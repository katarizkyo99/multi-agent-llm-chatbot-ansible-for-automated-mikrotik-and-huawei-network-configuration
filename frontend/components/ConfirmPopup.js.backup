// src/components/ConfirmPopup.js
import React from "react";

export default function ConfirmPopup({ pendingConfig, handleApproveConfig, handleRejectConfig }) {
    return (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-white p-6 rounded-xl shadow-xl text-center w-96">
                <h3 className="text-lg font-semibold mb-3 text-gray-800">
                    Apakah konfigurasi ini benar?
                </h3>
                <pre className="bg-gray-100 p-3 rounded text-sm text-left overflow-x-auto max-h-48 mb-4 whitespace-pre-wrap">
                    {pendingConfig}
                </pre>
                <div className="flex justify-center gap-3">
                    <button
                        onClick={handleApproveConfig}
                        className="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded"
                    >
                        Ya, lanjutkan
                    </button>
                    <button
                        onClick={handleRejectConfig}
                        className="bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded"
                    >
                        Tidak
                    </button>
                </div>
            </div>
        </div>
    );
}
